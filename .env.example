# Daily Business Research Skill — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.

# ─── GitHub Connector ───────────────────────────────────────────────────────
# Set these in your Claude Web Routine environment settings.
# The GitHub MCP connector uses OAuth/PAT configured in the Claude UI —
# these vars are for reference only; do not hard-code tokens here.

GITHUB_OWNER=your-github-username-or-org
GITHUB_REPO=your-repo-name

# ─── LINE Messaging API ──────────────────────────────────────────────────────
# Required to enable LINE notifications (Phase 7).
# If absent, the skill skips LINE notification but still commits the article.
#
# LINE_CHANNEL_ACCESS_TOKEN : Long-lived channel access token from LINE Developers Console
# LINE_TO                   : Target ID — User ID (Uxxxxxxx) or Group ID (Cxxxxxxx)

LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_TO=your_line_user_or_group_id_here

# ─── Optional Overrides ──────────────────────────────────────────────────────
# Timezone is fixed to Asia/Bangkok in the skill; do not override.
# TIMEZONE=Asia/Bangkok
